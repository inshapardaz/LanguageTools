# Copy to .env.local to point the dev server (npm start) at non-default hosts.
# Deployed containers ignore these; set API_URL / MAIN_SITE / NODE_ENV on the container instead.
VITE_API_URL=http://localhost:4000
VITE_MAIN_SITE=http://localhost:4200
# Links in the header's app switcher (this app is DICTIONARY_URL); container vars of the same names.
VITE_LIBRARIES_URL=http://localhost:4400
VITE_LIBRARY_EDITOR_URL=http://localhost:4300
VITE_DICTIONARY_URL=http://localhost:4500
